<%- include('partials/header') %>

    <main class="dashboard-page">
        <h1 class="dashboard-title">
            <%= title %>
        </h1>

        <!-- Side-by-Side Grid Container -->
        <div class="dashboard-grid">

            <!-- Left Column: Profile -->
            <div class="dashboard-card profile-card-container">
                <div class="profile-header-center">
                    <div class="avatar-circle">
                        <% if (role_name==='admin' ) { %>
                            <img src="/images/admin_profile.png" alt="Admin Profile" class="profile-avatar-img">
                        <% } else { %>
                            <img src="/images/user_profile.png" alt="User Profile" class="profile-avatar-img">
                        <% } %>
                    </div>
                    <h2>My Profile 👤</h2>
                </div>

                <div class="dashboard-details">
                    <p class="profile-name-row">
                        <strong>🏷️ Name:</strong>
                        <span><%= name %></span>
                    </p>
                    <p><strong>📧 Email:</strong>
                        <%= email %>
                    </p>

                    <% if (role_name === 'admin') { %>
                        <div class="admin-tools-row">
                            <p><strong>🛠️ Admin Tools:</strong></p>
                            <div class="admin-actions">
                                <a href="/users" class="btn btn-primary">Manage Registered Users</a>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Right Column: Volunteered Projects -->
            <div class="dashboard-card volunteered-projects">
                <h2>My Volunteered Projects ✋</h2>

                <% if (typeof volunteeredProjects !=='undefined' && volunteeredProjects && volunteeredProjects.length> 0) { %>
                    <!-- Activity Counter Summary -->
                    <p class="volunteer-summary-text">
                        You are currently registered for <strong><%= projectCount %></strong> project(s).
                    </p>

                    <ul class="volunteered-projects-list">
                        <% volunteeredProjects.forEach(function(project) { %>
                            <li class="volunteered-project-item">
                                <div class="project-info">
                                    <h3>
                                        <a href="/project/<%= project.project_id %>">
                                            <%= project.title %>
                                        </a>
                                    </h3>
                                    <p>
                                        📅 <%= project.project_date ? new
                                            Date(project.project_date).toLocaleDateString() : 'TBD' %>
                                            <% if (project.organization_name) { %>
                                                <br>🏛️️ <%= project.organization_name %>
                                                    <% } %>
                                    </p>
                                </div>
                                <div class="project-action">
                                    <!-- Removed onsubmit and added unvolunteer-trigger class + type="button" -->
                                    <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                                        <button type="button" class="btn btn-danger unvolunteer-trigger">
                                            Cancel
                                        </button>
                                    </form>
                                </div>
                            </li>
                            <% }); %>
                    </ul>
                    <% } else { %>
                        <p class="no-projects-text">You haven't signed up for any volunteer projects yet.</p>
                        <div class="browse-projects-wrapper">
                            <a href="/projects" class="btn btn-primary">Browse Projects</a>
                        </div>
                        <% } %>
            </div>

        </div>
    </main>

    <!-- Cancel Volunteer Confirmation Modal Overlay -->
    <div id="cancel-volunteer-modal" class="modal-overlay">
        <div class="modal-card">
            <h3>Cancel Volunteer Registration?</h3>
            <p>Are you sure you want to cancel your volunteer registration for this project?</p>
            <div class="modal-actions">
                <button type="button" id="cancel-unvolunteer" class="btn btn-secondary">Keep Registration</button>
                <button type="button" id="confirm-unvolunteer" class="btn btn-danger">Yes, Cancel</button>
            </div>
        </div>
    </div>

    <script src="/js/modals.js"></script>

    <%- include('partials/footer') %>