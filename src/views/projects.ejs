<%- include('partials/header') %>

    <main class="projects-page">
        <h1>
            <%= title %>
        </h1>

        <p>Here are our upcoming Service Projects below:</p>

        <ul class="upcoming-projects-list">
            <% projects.forEach(function(project) { %>
                <li class="upcoming-project-card">
                    <h3>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </h3>

                    <p><strong>💰 Sponsor:</strong>
                        <a href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>
                    </p>
                    <p><strong>📅 Date:</strong>
                        <%= new Date(project.date).toLocaleDateString('en-US', { month: 'short' , day: 'numeric' ,
                            year: 'numeric' }) %>
                    </p>
                    <p><strong>📍 Location:</strong>
                        <%= project.location %>
                    </p>
                    <p><strong>📝 Description:</strong>
                        <%= project.description %>
                    </p>
                </li>
                <% }); %>
        </ul>
        
        <% if (user && user.role_name==='admin' ) { %>
            <p><a href="/new-project">✍🏻 Add a New Service Project</a></p>
        <% } %>
    </main>

    <%- include('partials/footer') %>