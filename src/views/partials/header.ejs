<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/main.css">
</head>

<body>
    <nav>
        <!-- Hidden checkbox for mobile toggle -->
        <input type="checkbox" id="nav-toggle" class="nav-toggle">
    
        <!-- Mobile Header Bar (Visible only on mobile screens) -->
        <div class="nav-mobile-bar">
            <label for="nav-toggle" class="nav-toggle-btn" aria-label="Toggle navigation menu">
                <span></span>
                <span></span>
                <span></span>
            </label>
            <div class="nav-mobile-auth">
                <% if (isLoggedIn) { %>
                    <a href="/logout">Logout</a>
                <% } else { %>
                    <a href="/register">Register</a>
                    <a href="/login">Login</a>
                <% } %>
            </div>
        </div>
    
        <!-- Desktop Navigation Bar Container -->
        <% const current = typeof currentPath !== 'undefined' ? currentPath : ''; %>
        <div class="nav-container">
            <ul class="nav-main">
                <li><a href="/" class="<%= current === '/' ? 'active' : '' %>">Home</a></li>
                <li><a href="/organizations" class="<%= current.startsWith('/organizations') ? 'active' : '' %>">Organizations</a></li>
                <li><a href="/projects" class="<%= current.startsWith('/projects') ? 'active' : '' %>">Projects</a></li>
                <li><a href="/categories" class="<%= current.startsWith('/categories') ? 'active' : '' %>">Categories</a></li>
            </ul>

            <ul class="nav-auth">
                <% if (isLoggedIn) { %>
                    <li><a href="/logout" class="btn-nav btn-nav-secondary">Logout</a></li>
                <% } else { %>
                    <li><a href="/register" class="btn-nav btn-nav-secondary">Register</a></li>
                    <li><a href="/login" class="btn-nav btn-nav-primary">Login</a></li>
                <% } %>
            </ul>
        </div>
    </nav>

    <% const messages=flash(); %>
    <% if (Object.keys(messages).some(type=> messages[type].length > 0)) { %>
        <% Object.keys(messages).forEach(type=> { %>
            <% if (messages[type].length> 0) { %>
                <div class="flash-messages <%= type %>">
                    <% messages[type].forEach(msg=> { %>
                        <p>
                            <%= msg %>
                        </p>
                    <% }); %>
                </div>
            <% } %>
        <% }); %>
    <% } %>

    <% /* Render validation errors array if passed from route */%>
    <% if (typeof errors !=='undefined' && errors && errors.length> 0) { %>
        <div class="flash-messages error">
            <% errors.forEach(function(error) { %>
                <p>
                    <%= error %>
                </p>
            <% }); %>
        </div>
    <% } %>