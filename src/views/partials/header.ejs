<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/main.css">
</head>

<body>
    <nav>
        <!-- Hidden checkbox for toggle -->
        <input type="checkbox" id="nav-toggle" class="nav-toggle">
    
        <!-- Mobile Header Bar (Visible only on mobile screens) -->
        <div class="nav-mobile-bar">
            <label for="nav-toggle" class="nav-toggle-btn" aria-label="Toggle navigation menu">
                <span></span>
                <span></span>
                <span></span>
            </label>
            <div class="nav-mobile-auth">
                <% if (isLoggedIn) { %>
                    <a href="/logout">Logout</a>
                    <% } else { %>
                        <a href="/register">Register</a>
                        <a href="/login">Login</a>
                        <% } %>
            </div>
        </div>
    
        <!-- Main Navigation List -->
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/organizations">Organizations</a></li>
            <li><a href="/projects">Projects</a></li>
            <li><a href="/categories">Categories</a></li>
            <% if (isLoggedIn) { %>
                <li class="desktop-auth-item"><a href="/logout">Logout</a></li>
                <% } else { %>
                    <li class="desktop-auth-item"><a href="/register">Register</a></li>
                    <li class="desktop-auth-item"><a href="/login">Login</a></li>
                    <% } %>
        </ul>
    </nav>

    <% const messages=flash(); %>
    <% if (Object.keys(messages).some(type=> messages[type].length > 0)) { %>
        <% Object.keys(messages).forEach(type=> { %>
            <% if (messages[type].length> 0) { %>
                <div class="flash-messages <%= type %>">
                    <% messages[type].forEach(msg=> { %>
                        <p>
                            <%= msg %>
                        </p>
                    <% }); %>
                </div>
            <% } %>
        <% }); %>
    <% } %>

    <% /* Render validation errors array if passed from route */%>
    <% if (typeof errors !=='undefined' && errors && errors.length> 0) { %>
        <div class="flash-messages error">
            <% errors.forEach(function(error) { %>
                <p>
                    <%= error %>
                </p>
            <% }); %>
        </div>
    <% } %>