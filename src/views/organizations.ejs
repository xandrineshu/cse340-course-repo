<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <p>Here are a few of our partner organizations:</p>
        <ul>
            <% organizations.forEach(organization=> { %>
                <li>
                    <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                    <a href="/organization/<%= organization.organization_id %>" class="org-name-link">
                        <%= organization.name %>
                    </a>
                    <span class="org-email">
                        <%= organization.contact_email %>
                    </span>
                </li>
                <% }); %>
        </ul>

        <p><a href="/new-organization">✍🏻 Add New Organization</a></p>
        
    </main>

    <%- include('partials/footer') %>